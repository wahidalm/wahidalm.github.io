<script type="module">
  // Only run in browser, never during SSR/build
  if (typeof window === 'undefined') return;

  const SUPA_URL = 'https://tllrpbryxtrnpgruzgum.supabase.co';
  const SUPA_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRsbHJwYnJ5eHRybnBncnV6Z3VtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjUzNzMyNDYsImV4cCI6MjA4MDk0OTI0Nn0._02eH5VMlH9rRUTn_bJoC-aNg-TU10XreK377ofmFag';
  const IP_KEY = 'e50c6fe7f2c760aa7666bf69bfd97a21';

  (async () => {
    try {
      const ipRes = await fetch('https://api.ipify.org?format=json');
      const { ip } = await ipRes.json();

      const geoRes = await fetch(`https://api.ipapi.com/api/${ip}?access_key=${IP_KEY}&fields=country_name,city`);
      const geo = await geoRes.json();

      await fetch(`${SUPA_URL}/rest/v1/visitors`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPA_KEY,
          'Authorization': `Bearer ${SUPA_KEY}`
        },
        body: JSON.stringify({
          ip: ip,
          country: geo.country_name || 'Unknown',
          city: geo.city || 'Unknown',
          visited_at: new Date().toISOString()
        })
      });
    } catch (e) {
      // Silently fail - don't break the site if logging fails
      console.warn('Visitor logging failed:', e);
    }
  })();
</script>