---
// Logger.astro - Secure client-side visitor tracking
---

<script type="module">
  const EDGE_URL = 'https://bolwzblnkatfdobjeqey.supabase.co/functions/v1/log-visitor';
  const ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJvbHd6Ymxua2F0ZmRvYmplcWV5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM2NzEyOTcsImV4cCI6MjA5OTI0NzI5N30.xaZJR3A6QIncDSC2IwRMCLaRvUMcgo12R5QX_LPTu0U';
  const IP_KEY = 'e50c6fe7f2c760aa7666bf69bfd97a21';
  const SESSION_KEY = 'visitor_logged';

  // Prevent duplicate logging during the same browser session
  if (sessionStorage.getItem(SESSION_KEY)) return;

  (async () => {
    try {
      const ipRes = await fetch('https://api.ipify.org?format=json');
      const { ip } = await ipRes.json();

      const geoRes = await fetch(`https://api.ipapi.com/api/${ip}?access_key=${IP_KEY}&fields=country_name,city`);
      const geo = await geoRes.json();

      await fetch(EDGE_URL, {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${ANON_KEY}`
        },
        body: JSON.stringify({
          ip,
          country: geo.country_name || 'Unknown',
          city: geo.city || 'Unknown'
        })
      });

      sessionStorage.setItem(SESSION_KEY, 'true');
    } catch (e) {
      console.warn('Visitor logging failed:', e);
    }
  })();
</script>