---
const today = new Date();

const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#exp', label: 'Experience' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#contact', label: 'Contact' },
  { href: '/blog', label: 'Blog' },
];

const socialLinks = [
  {
    href: 'https://www.linkedin.com/in/wahiduz-alam-519995313/',
    label: 'LinkedIn',
    icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
  },
  {
    href: 'https://github.com/wahidalm',
    label: 'GitHub',
    icon: `<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>`,
  },
  {
    href: 'https://x.com/MrNobodyPlays1',
    label: 'X (Twitter)',
    icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
  },
  {
    href: 'mailto:wahiduzalam@gmail.com',
    label: 'Email',
    icon: `<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>`,
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top Branding & Status Section -->
    <div class="footer-top">
      <div class="brand-block">
        <a href="/" class="brand-title">Wahiduz Zaman Alam</a>
        <p class="brand-desc">Full Stack Engineer & Mobile Developer crafting clean, modern web & mobile applications.</p>
      </div>

      <div class="status-block">
        <div class="status-badge">
          <span class="status-dot"></span>
          <span>Open to new opportunities</span>
        </div>
      </div>
    </div>

    <!-- Navigation Pills -->
    <nav class="footer-nav" aria-label="Footer navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-item">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Social Icon Buttons -->
    <div class="social-row">
      {socialLinks.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('mailto:') ? '_self' : '_blank'}
          rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          class="social-btn"
          aria-label={s.label}
          title={s.label}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <Fragment set:html={s.icon} />
          </svg>
        </a>
      ))}
    </div>

    <div class="footer-divider"></div>

    <!-- Bottom Copyright & Colophon -->
    <div class="footer-bottom">
      <p class="copyright">&copy; {today.getFullYear()} Wahiduz Zaman Alam. All rights reserved.</p>
      <p class="colophon">Designed &amp; built with Astro &bull; Delhi, India</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: 5rem;
    padding: 3.5rem 1.5rem 2.5rem;
    background: var(--card);
    border-top: 1px solid var(--border);
    box-sizing: border-box;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .footer-inner {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* Top Section */
  .footer-top {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    text-align: left;
  }

  .brand-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brand-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text) !important;
    text-decoration: none !important;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }
  .brand-title:hover {
    color: var(--accent) !important;
  }

  .brand-desc {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text);
    opacity: 0.72;
    max-width: 460px;
    line-height: 1.5;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    display: inline-block;
    animation: pulse-dot 2.5s infinite;
  }

  @keyframes pulse-dot {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  /* Nav Links - High specificity to override global a { color: var(--accent) } */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 9999px;
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .footer-nav .nav-item,
  .footer-nav .nav-item:visited,
  .footer-nav .nav-item:link {
    color: var(--text) !important;
    text-decoration: none !important;
    font-size: 0.88rem;
    font-weight: 500;
    opacity: 0.75;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .footer-nav .nav-item:hover {
    color: var(--accent) !important;
    opacity: 1;
    background: rgba(35, 55, 255, 0.08);
    transform: translateY(-1px);
  }

  :global(html.dark) .footer-nav .nav-item:hover {
    background: rgba(79, 107, 255, 0.15);
  }

  /* Social Icons */
  .social-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .social-btn,
  .social-btn:visited,
  .social-btn:link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--text) !important;
    border: 1px solid var(--border);
    opacity: 0.8;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none !important;
  }

  .social-btn:hover {
    color: #ffffff !important;
    background: var(--accent);
    border-color: var(--accent);
    opacity: 1;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(35, 55, 255, 0.3);
  }

  .social-btn svg {
    transition: transform 0.2s ease;
  }

  .social-btn:hover svg {
    transform: scale(1.1);
  }

  /* Divider */
  .footer-divider {
    width: 100%;
    height: 1px;
    background: var(--border);
    opacity: 0.7;
    margin: 0.25rem 0;
  }

  /* Bottom Row */
  .footer-bottom {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.84rem;
    color: var(--text);
    opacity: 0.7;
  }

  .footer-bottom p {
    margin: 0;
  }

  .copyright {
    font-weight: 400;
  }

  .colophon {
    font-size: 0.8rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 720px) {
    .site-footer {
      padding: 2.75rem 1.25rem 2rem;
      margin-top: 3.5rem;
    }

    .footer-top {
      flex-direction: column;
      text-align: center;
      align-items: center;
      gap: 1rem;
    }

    .brand-desc {
      text-align: center;
    }

    .footer-nav {
      border-radius: 16px;
      gap: 0.25rem;
      padding: 0.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.4rem;
    }
  }
</style>
