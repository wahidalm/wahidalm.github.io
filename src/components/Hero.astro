---
export interface Props {
  name: string;
  title: string;
  email: string;
  location: string;
  img: string;
}

const { name, title, email, location, img } = Astro.props;
---

<section class="hero">
  <div class="card">
    <img src={img} alt={name} class="avatar" loading="eager" />
    <h1>{name}</h1>
    <p class="title">{title}</p>
    <p class="email">
      <span class="label">Email:</span>
      <a href={`mailto:${email}`}>{email}</a>
    </p>
    <p class="location">
      <span class="label">Location:</span> {location}
    </p>
    <div class="social-links">
      <a href="https://github.com/wahidalm" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/wahiduz-alam-519995313/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://x.com/MrNobodyPlays1" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" title="X (Twitter)">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>
    <a href="/cv.pdf" class="btn" download>Download CV</a>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: linear-gradient(-45deg, #ff9a9dbb, #fecfefb0, #a8ede9a1, #fed6e38f);
    background-size: 400% 400%;
    animation: bg 10s ease infinite;
  }

  @keyframes bg {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .card {
    width: 90%;
    max-width: 420px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    text-align: center;
    color: var(--text);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 12px 40px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.25) inset;
  }

  /* DARK MODE - Stronger glass effect */
  html.dark .card {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 0 40px rgba(99, 102, 241, 0.15);
    color: #e2e8f0;
  }
  html.dark .card:hover {
    box-shadow: 
      0 12px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.15) inset,
      0 0 50px rgba(99, 102, 241, 0.25);
  }

  .avatar {
    width: clamp(100px, 35vw, 180px);
    height: clamp(100px, 35vw, 180px);
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.25rem;
    border: 4px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
  }

  html.dark .avatar {
    border: 4px solid rgba(255, 255, 255, 0.3);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 0 20px rgba(99, 102, 241, 0.3);
  }
  html.dark .avatar:hover {
    box-shadow: 
      0 6px 24px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(99, 102, 241, 0.4);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    font-weight: 700;
    color: #1a1a2e;
  }
  html.dark h1 {
    color: #f1f5f9;
    text-shadow: 0 2px 10px rgba(99, 102, 241, 0.3);
  }

  .title {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(1rem, 3vw, 1.25rem);
    opacity: 0.85;
    color: #4a5568;
    font-weight: 500;
  }
  html.dark .title {
    color: #94a3b8;
  }

  .email, .location {
    margin: 0.5rem 0;
    font-size: clamp(0.85rem, 2vw, 1rem);
    opacity: 0.8;
    text-align: center;
    color: #4a5568;
  }
  html.dark .email,
  html.dark .location {
    color: #94a3b8;
  }

  .label {
    font-weight: 600;
    color: var(--accent);
  }
  html.dark .label {
    color: #818cf8;
  }

  .email a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .email a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
  }
  html.dark .email a {
    color: #818cf8;
  }
  html.dark .email a:hover {
    color: #a5b4fc;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 1rem 0 0.5rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    color: #1a1a2e;
    transition: all 0.3s;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .social-links a:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(35, 55, 255, 0.3);
  }

  html.dark .social-links a {
    background: rgba(255, 255, 255, 0.1);
    color: #f1f5f9;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  html.dark .social-links a:hover {
    background: #4f46e5;
    color: #fff;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
  }

  .btn {
    margin-top: 1.5rem;
    padding: 0.6rem 1.5rem;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    transition: all 0.3s;
    box-shadow: 0 4px 12px rgba(35, 55, 255, 0.3);
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(35, 55, 255, 0.4);
    background: var(--accent-dark);
  }
  html.dark .btn {
    background: #4f46e5;
    box-shadow: 
      0 4px 12px rgba(79, 70, 229, 0.4),
      0 0 20px rgba(79, 70, 229, 0.2);
  }
  html.dark .btn:hover {
    background: #6366f1;
    box-shadow: 
      0 6px 20px rgba(79, 70, 229, 0.5),
      0 0 30px rgba(79, 70, 229, 0.3);
    transform: translateY(-2px);
  }
</style>