---
export interface Props {
  name: string;
  title: string;
  email: string;
  location: string;
  img: string;
}

const { name, title, email, location, img } = Astro.props;
---

<section class="hero">
  <div class="card">
    <img src={img} alt={name} class="avatar" loading="eager" />
    <h1>{name}</h1>
    <p class="title">{title}</p>
    <p class="email">
      <span class="label">Email:</span>
      <a href={`mailto:${email}`}>{email}</a>
    </p>
    <p class="location">
      <span class="label">Location:</span> {location}
    </p>
    <a href="/cv.pdf" class="btn" download>Download CV</a>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: linear-gradient(-45deg, #ff9a9dbb, #fecfefb0, #a8ede9a1, #fed6e38f);
    background-size: 400% 400%;
    animation: bg 10s ease infinite;
  }

  @keyframes bg {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .card {
    width: 90%;
    max-width: 420px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    text-align: center;
    color: var(--text);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 12px 40px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.25) inset;
  }

  /* DARK MODE - Stronger glass effect */
  html.dark .card {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 0 40px rgba(99, 102, 241, 0.15);
    color: #e2e8f0;
  }
  html.dark .card:hover {
    box-shadow: 
      0 12px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.15) inset,
      0 0 50px rgba(99, 102, 241, 0.25);
  }

  .avatar {
    width: clamp(100px, 35vw, 180px);
    height: clamp(100px, 35vw, 180px);
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.25rem;
    border: 4px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
  }

  html.dark .avatar {
    border: 4px solid rgba(255, 255, 255, 0.3);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 0 20px rgba(99, 102, 241, 0.3);
  }
  html.dark .avatar:hover {
    box-shadow: 
      0 6px 24px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(99, 102, 241, 0.4);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    font-weight: 700;
    color: #1a1a2e;
  }
  html.dark h1 {
    color: #f1f5f9;
    text-shadow: 0 2px 10px rgba(99, 102, 241, 0.3);
  }

  .title {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(1rem, 3vw, 1.25rem);
    opacity: 0.85;
    color: #4a5568;
    font-weight: 500;
  }
  html.dark .title {
    color: #94a3b8;
  }

  .email, .location {
    margin: 0.5rem 0;
    font-size: clamp(0.85rem, 2vw, 1rem);
    opacity: 0.8;
    text-align: center;
    color: #4a5568;
  }
  html.dark .email,
  html.dark .location {
    color: #94a3b8;
  }

  .label {
    font-weight: 600;
    color: var(--accent);
  }
  html.dark .label {
    color: #818cf8;
  }

  .email a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .email a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
  }
  html.dark .email a {
    color: #818cf8;
  }
  html.dark .email a:hover {
    color: #a5b4fc;
  }

  .btn {
    margin-top: 1.5rem;
    padding: 0.6rem 1.5rem;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    transition: all 0.3s;
    box-shadow: 0 4px 12px rgba(35, 55, 255, 0.3);
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(35, 55, 255, 0.4);
    background: var(--accent-dark);
  }
  html.dark .btn {
    background: #4f46e5;
    box-shadow: 
      0 4px 12px rgba(79, 70, 229, 0.4),
      0 0 20px rgba(79, 70, 229, 0.2);
  }
  html.dark .btn:hover {
    background: #6366f1;
    box-shadow: 
      0 6px 20px rgba(79, 70, 229, 0.5),
      0 0 30px rgba(79, 70, 229, 0.3);
    transform: translateY(-2px);
  }
</style>