---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Wahiduz Zaman Alam",
  "jobTitle": "Software Engineer",
  "url": "https://wahidalm.github.io",
  "email": "mailto:wahiduzalam@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Assam",
    "addressCountry": "India"
  },
  "sameAs": [
    "https://github.com/wahidalm",
    "https://www.linkedin.com/in/wahiduz-alam-519995313/",
    "https://x.com/MrNobodyPlays1"
  ],
  "knowsAbout": [
    "Frontend Development",
    "React",
    "Next.js",
    "Astro",
    "Flutter",
    "Django",
    "JavaScript",
    "Python",
    "Web Development"
  ]
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content="Wahiduz Zaman Alam" />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<!-- Preload fonts -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />