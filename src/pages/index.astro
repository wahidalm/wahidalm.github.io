---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Hero from "../components/Hero.astro";
import Experience from "./experience.astro";
import Projects from "./Projects.astro";
import Contact from "./contact.astro";
import Skills from "../components/Skills.astro";
import '../styles/global.css';
import ScrollDown from "../components/ScrollDown.astro";
import Logger from "../components/Logger.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Logger />
    <Header />
    <Hero
      name="Wahiduz Zaman Alam"
      title="Software Engineer"
      email="wahiduzalam@gmail.com"
      location="Assam, India"
      img="../wahid-alam.webp"
    />

    <main id="main-content">
      <div class="section-end"></div>

      <!-- About Section -->
      <section id="about" class="page-section">
        <div class="about-context">
          <div class="about-greeting">
            Hello, I'm <span class="highlight">Wahiduz Zaman Alam</span>.
          </div>
          <div>
            <p>
              I am a Senior Full-Stack Software Engineer &amp; Product Manager focused on architecting scalable web platforms and AI-powered mobile ecosystems. I specialize in bridging product vision with robust, end-to-end technical execution to create delightful digital experiences.
            </p>
            <p>
              Over the years, I’ve built responsive, high-performance web applications using React, Next.js, and Astro, alongside native cross-platform mobile apps with Flutter and Dart. On the backend, I design heavy, scalable infrastructure using Python, Django, PostgreSQL, and Redis, deployed via containerized Docker environments.
            </p>
            <p>
              Beyond code, I step into product management—shaping feature workflows, orchestrating cross-functional teams, and integrating modern AI capabilities to solve complex problems (most recently in the industrial quick-commerce space). I also enjoy creating architecture walkthroughs and visual guides to simplify complex workflows for both users and engineering teams.
            </p>
            <p>
              I love building intuitive interfaces, optimizing system performance, and continuously leveraging new technologies to build platforms that make a real-world impact.
            </p>
          </div>
        </div>
      </section>

      <div class="section-end"></div>

      <!-- Experience Section -->
      <section id="exp" class="page-section">
        <Experience isSection={true} />
      </section>

      <div class="section-end"></div>

      <!-- Skills Section -->
      <section id="skills" class="page-section">
        <Skills isSection={true} />
      </section>

      <div class="section-end"></div>

      <!-- Projects Section -->
      <section id="projects" class="page-section">
        <Projects isSection={true} />
      </section>

      <div class="section-end"></div>

      <!-- Contact Section -->
      <section id="contact" class="page-section">
        <Contact />
      </section>
    </main>

    <ScrollDown />
    <Footer />
  </body>
</html>

<style>
  .page-section {
    padding: 2.5rem 0;
    scroll-margin-top: 80px;
  }

  .section-end {
    margin: 0 auto;
    width: 100%;
    height: 2px;
    background: var(--section);
    border-radius: 2px;
  }

  .about-context {
    max-width: 680px;
    margin: 0 auto;
    scroll-margin-top: 80px;
  }

  .about-greeting {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  @media (max-width: 600px) {
    .page-section {
      padding: 2rem 0;
    }
  }
</style>
